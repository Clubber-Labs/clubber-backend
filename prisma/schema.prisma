enum ReportReason {
  HATE_SPEECH
  SPAM_OR_FRAUD
  HARASSMENT
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED_INVALID
  RESOLVED_REMOVED
  // Resolução com ação sobre o usuário denunciado (módulo de moderação).
  RESOLVED_SUSPENDED
  RESOLVED_BANNED
}

model Report {
  id             String       @id @default(uuid())
  reason         ReportReason
  details        String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  reporterId String
  reporter   User   @relation("reporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  targetUserId String?
  targetUser   User?   @relation("targetUserReports", fields: [targetUserId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  reviewerId String?
  reviewer   User?   @relation("reportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  evidence ReportEvidence?

  @@unique([reporterId, eventId, status], map: "reports_reporter_event_status_unique")
  @@unique([reporterId, commentId, status], map: "reports_reporter_comment_status_unique")
  @@unique([reporterId, messageId, status], map: "reports_reporter_message_status_unique")
  @@unique([reporterId, postId, status], map: "reports_reporter_post_status_unique")
  @@unique([reporterId, targetUserId, status], map: "reports_reporter_target_user_status_unique")
  @@index([reporterId, eventId, status], map: "reports_reporter_event_status_idx")
  @@index([reporterId, commentId, status], map: "reports_reporter_comment_status_idx")
  @@index([reporterId, messageId, status], map: "reports_reporter_message_status_idx")
  @@index([reporterId, postId, status], map: "reports_reporter_post_status_idx")
  @@index([reporterId, targetUserId, status], map: "reports_reporter_target_user_status_idx")
  @@index([reviewerId], map: "reports_reviewer_idx")
  // Fixup do cascade de messages (SetNull): sem índice liderando em messageId,
  // apagar uma conversa varre reports por mensagem apagada.
  @@index([messageId], map: "reports_message_idx")
  @@index([status, createdAt, id], map: "reports_status_created_at_id_idx")
  @@map("reports")
}

enum ReportEvidenceKind {
  CHAT_MESSAGE
}

/// Snapshot IMUTÁVEL do conteúdo denunciado, capturado no ato da denúncia.
/// Existe porque a mensagem cifrada é um alvo móvel: o autor pode editá-la ou
/// apagá-la depois de denunciada, e sem snapshot a moderação perderia a prova
/// que justifica a punição.
model ReportEvidence {
  id       String             @id @default(uuid())
  reportId String             @unique
  report   Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind     ReportEvidenceKind @default(CHAT_MESSAGE)

  // DEK PRÓPRIA da evidência, envelopada pela KEK — deliberadamente NÃO a da
  // conversa: rotação e crypto-shredding da conversa não podem destruir a prova.
  wrappedDek    Bytes
  kekVersion    Int
  iv            Bytes
  tag           Bytes
  alg           String @default("AES-256-GCM")
  // JSON cifrado: a mensagem denunciada, o contexto ao redor e as DEKs dos
  // anexos — autocontido, para seguir legível após o shred da conversa.
  payloadCipher Bytes

  // Referências DESNORMALIZADAS, sem FK, de propósito: a evidência precisa
  // sobreviver ao cascade da conversa e ao SetNull de Report.messageId.
  conversationId    String?
  reportedMessageId String?
  reportedUserId    String?
  contextCount      Int      @default(0)
  // Mídia que a remoção do conteúdo NÃO apaga, por ser prova. O reconciler de
  // retenção é quem a expurga no fim do prazo.
  retainedMediaKeys String[]

  capturedAt DateTime  @default(now())
  purgedAt   DateTime?

  @@index([kekVersion])
  @@index([capturedAt])
  @@map("report_evidences")
}

enum ModerationAccessAction {
  VIEW_EVIDENCE
}

/// Trilha de quem da moderação leu conteúdo privado de chat em claro. Gravado
/// na MESMA transação da leitura, antes de qualquer decifra: se o log falha, o
/// admin não vê nada (fail-closed).
model ModerationAccessLog {
  id      String @id @default(uuid())
  adminId String
  admin   User   @relation("moderationAccessLogs", fields: [adminId], references: [id], onDelete: Cascade)

  action     ModerationAccessAction
  reportId   String?
  evidenceId String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime               @default(now())

  @@index([adminId, createdAt])
  @@index([reportId])
  @@index([createdAt])
  @@map("moderation_access_logs")
}

