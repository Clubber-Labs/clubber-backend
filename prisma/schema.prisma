enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId   String             @unique
  stripePriceId          String
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  // Método de pagamento (id do PaymentMethod no Stripe). Null = sem cartão. Um
  // trial criado pelo PaymentSheet nasce sem cartão; só vira premium quando o
  // SetupIntent conclui e grava o método aqui. "Sticky": eventos posteriores
  // sem o campo não zeram (ver upsertSubscriptionTx).
  defaultPaymentMethodId String?
  startedAt              DateTime           @default(now())
  // Timestamp do último evento Stripe aplicado. Comparado com event.created
  // pra descartar eventos fora de ordem (Stripe não garante ordering).
  lastSyncedAt           DateTime           @default(now())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  // userId NÃO é @unique: user pode ter histórico (canceladas + nova ativa).
  // Query "ativa": WHERE userId AND status IN (TRIALING, ACTIVE, PAST_DUE).
  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model WebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       Json

  @@map("webhook_events")
}

// ── LGPD ────────────────────────────────────────────────────

model UserConsent {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Essencial (sempre true, imutável)
  essentialAccepted Boolean @default(true)

  // Espelho da permissão do SO — quem decide é o iOS/Android; o app replica
  // aqui quando ela muda. Não são declaração de vontade, mas ficam nesta tabela
  // porque os JOINs de push (proximidade, digest, chat) filtram por eles.
  locationPrecise   Boolean @default(false) // GPS em tempo real
  pushNotifications Boolean @default(false) // Notificações push

  // Consentimento no sentido estrito: opt-in explícito, default false.
  marketing Boolean @default(false) // Comunicações de marketing
  surveys   Boolean @default(false) // Participação em pesquisas
  // Gosto musical importado do Spotify. Concedido ao vincular a conta e
  // revogado ao desvincular — o tratamento existe enquanto o vínculo existir.
  spotifyData Boolean @default(false)

  consentVersion String    @default("1.0")
  ipAddress      String?
  userAgent      String?
  collectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  revokedAt      DateTime?

  // @@index([userId]) removido — userId @unique já cria índice implícito
  @@map("user_consents")
}

enum TermsDocument {
  TERMS_OF_USE
  PRIVACY_POLICY
}

/// Registro append-only de aceite de documento, por versão. Colunas no User
/// guardariam só o último aceite; aqui fica a linha do tempo inteira, que é o
/// que sustenta o ônus da prova do Art. 8 §2 quando a política mudar de versão.
model TermsAcceptance {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  document TermsDocument
  version  String

  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  // Reaceitar a mesma versão não é informação nova — o unique torna o aceite
  // idempotente e a transação do cadastro seguramente retentável.
  @@unique([userId, document, version])
  @@index([userId, document, acceptedAt])
  @@map("terms_acceptances")
}

enum ConsentAction {
  GRANTED
  UPDATED
  REVOKED
  EXPORTED
}

model ConsentAuditLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action         ConsentAction
  changedFields  Json // { field: string, from: boolean|null, to: boolean }[]
  ipAddress      String?
  userAgent      String?
  consentVersion String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("consent_audit_logs")
}

enum AccountLifecycleAction {
  DEACTIVATED
  DELETION_SCHEDULED
  REACTIVATED
  SUSPENDED
  BANNED
  UNSUSPENDED
}

// Log append-only do ciclo de vida da conta. Guarda o "motivo de saída"
// (opcional) informado ao desativar/excluir — fonte de analytics de churn.
// Sobrevive à anonimização (o usuário não é deletado, só anonimizado).
model AccountLifecycleLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action AccountLifecycleAction
  reason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@map("account_lifecycle_logs")
}

// ── Notificações ────────────────────────────────────────────

enum NotificationType {
  EVENT_NEARBY
  SPOT_NEARBY
  SPOT_JOIN
  SPOT_RENEWAL
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  NEW_FOLLOWER
  EVENT_INVITE
  EVENT_COMMENT
  POST_COMMENT
  EVENT_REACTION
  POST_REACTION
  COMMENT_REACTION
  EVENT_ATTENDANCE
}

// Token de push (Expo) de um device do usuário. invalidatedAt marca soft-disable
// (ex.: DeviceNotRegistered no envio) sem apagar — preserva auditoria e permite
// reativar se o app re-registrar o mesmo token. O envio em si é da entrega 5.
model DeviceToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token             String    @unique
  platform          String?
  invalidatedAt     DateTime?
  invalidatedReason String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pushTickets PushTicket[]

  @@index([userId])
  @@map("device_tokens")
}

// Ticket de um push enviado ao Expo. O envio retorna só o ticket (recebido pelos
// servidores do Expo, NÃO pelo device); o receipt — buscado ~15min depois — diz
// se entregou. status=PENDING até o reconciler ler o receipt; DeviceNotRegistered
// no receipt invalida o DeviceToken.
model PushTicket {
  id            String      @id @default(uuid())
  deviceTokenId String
  deviceToken   DeviceToken @relation(fields: [deviceTokenId], references: [id], onDelete: Cascade)
  receiptId     String?
  status        String      @default("PENDING")
  error         String?
  createdAt     DateTime    @default(now())

  @@index([status, createdAt])
  @@map("push_tickets")
}

// Notificação in-app (central + base do push). `dedupeKey` torna o fan-out
// idempotente (retry/duplo gatilho não duplica): a app monta a chave a partir do
// tipo + alvos. Referências de alvo (actor/event/post/comment) são colunas soltas,
// sem FK — a notificação é histórica/efêmera (expurgo por retenção) e tolera alvo
// removido. Só userId (destinatário) é relação, com cascade.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String?
  eventId   String?
  postId    String?
  commentId String?
  spotId    String?
  /// Snapshot do que a leitura não deriva da FK (título de spot/evento). O texto
  /// em si não é gravado: sai de params + tipo no idioma de quem lê.
  params    Json?
  data      Json?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  // Cobre o keyset (userId, createdAt DESC, id DESC): o `id` no índice evita
  // heap scan no desempate de createdAt igual. Btree serve via scan reverso.
  @@index([userId, createdAt, id])
  @@map("notifications")
}

enum SpotVisibility {
  PUBLIC
  FRIENDS
}

// Spot = rolê sugerido, ancorado num estabelecimento real (placeId do Google
// Places), com janela de tempo (startsAt/endsAt) e um grupo de chat criado junto.
// Distinto de Event: mais leve, efêmero, e o "ser membro" É participar do chat
// (conversationId). FRIENDS = visível só para follow mútuo do criador.
// A coluna `location` geography é GERADA via SQL cru, fora do schema — igual a
// events.location (ver migration).
model Spot {
  id                String          @id @default(uuid())
  title             String
  description       String?
  categories        EventCategory[]
  // Subcategorias/gêneros do rolê (chaves de interesse config). Imutáveis após a
  // criação (como categorias/local), usadas no match de proximidade de 2º nível.
  subcategories     String[]        @default([])
  visibility        SpotVisibility  @default(PUBLIC)
  placeId           String
  latitude          Float
  longitude         Float
  startsAt          DateTime
  endsAt            DateTime
  canceledAt        DateTime?
  // Marcado quando o lembrete de renovação é enviado; zerado ao renovar
  // (re-arma o lembrete para a nova janela). NULL = ainda não lembrado.
  renewalNotifiedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  creatorId String
  creator   User   @relation("spotsCreated", fields: [creatorId], references: [id])

  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([creatorId])
  // Lembrete: spots ativos vencendo ainda não lembrados.
  @@index([renewalNotifiedAt, endsAt, canceledAt], map: "spots_renewal_reminder_idx")
  @@index([categories], type: Gin)
  @@index([subcategories], type: Gin)
  @@map("spots")
}

// Quota diária de geração de sugestões de spot (botão "gerar"). Uma linha por
// (usuário, dia); `count` é consumido de forma atômica. Free = 5, premium = 25
// (o limite é regra de negócio no service, não no schema). A renovação de spot
// no lifecycle consome desta MESMA quota.
model SpotGenerationUsage {
  userId    String
  day       DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("spot_generation_usage")
}

// Cap diário de notificações de DESCOBERTA (SPOT_NEARBY fora da preferência,
// alcance premium): limita quantas o usuário recebe por dia (anti-spam). Mesma
// forma do SpotGenerationUsage, consumido em lote de forma atômica.
model SpotDiscoveryUsage {
  userId    String
  day       DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("spot_discovery_usage")
}

// Quota MENSAL de promoções de evento (RF11.4+, premium). Uma linha por
// (usuário, mês); `period` é o 1º dia do mês em UTC. `count` é consumido de
// forma atômica DENTRO da transação de criação do destaque — exceder o limite
// (env PROMOTION_MONTHLY_LIMIT) lança 429 e o rollback desfaz o incremento.
// Cancelar um destaque NÃO devolve a quota. O mês é calendário (não o ciclo
// de billing) — aceitável no MVP.
model EventPromotionUsage {
  userId    String
  period    DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, period])
  @@map("event_promotion_usage")
}
