// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  // `native` cobre o dev local; `debian-openssl-3.0.x` é o runtime da imagem
  // Docker (node:24-slim / bookworm) usada nos testes de carga.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

// Ciclo de vida da conta (soft-delete estilo Instagram):
// ACTIVE -> DEACTIVATED (desativar) / PENDING_DELETION (excluir, com carência)
// -> ACTIVE (reativar no login) ou ANONYMIZED (job após a carência, terminal).
enum AccountStatus {
  ACTIVE
  DEACTIVATED
  PENDING_DELETION
  ANONYMIZED
  // Estados impostos pela moderação (distintos do ciclo de vida self-service
  // acima). SUSPENDED é temporário (expira em suspendedUntil); BANNED é
  // permanente. Ambos ficam fora de VISIBLE_AS_USER/AUTHOR → conteúdo e perfil
  // somem; e bloqueiam login (não são reativados por reactivateOnLogin).
  SUSPENDED
  BANNED
}

model User {
  id               String    @id @default(uuid())
  name             String
  lastname         String
  username         String    @unique
  email            String    @unique
  password         String?
  phone            String?   @unique
  bio              String?
  avatarUrl        String?
  avatarKey        String?
  isPrivate        Boolean   @default(false)
  isPremium        Boolean   @default(false)
  stripeCustomerId String?   @unique
  role             UserRole  @default(USER)
  // MFA (TOTP). mfaSecret é o segredo base32 CIFRADO em repouso (AES-256-GCM com
  // chave derivada do JWT_SECRET); só é populado durante/após o cadastro.
  // mfaRecoveryCodes guarda hashes (uso único) dos códigos de recuperação.
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaRecoveryCodes String[]  @default([])
  followersCount   Int       @default(0)
  followingCount   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  birthdate        DateTime?
  lastSeenAt       DateTime?

  // Localização grosseira (geohash) para notificações por proximidade. A coluna
  // `location` geography é GERADA via SQL cru (ST_PointFromGeoHash), fora do
  // schema — igual a events.location. notifyRadiusKm é o raio de interesse.
  locationGeohash   String?
  locationUpdatedAt DateTime?
  notifyRadiusKm    Int       @default(10)
  // Raio de interesse (km) para a recomendação de spots — espelha o
  // notifyRadiusKm. Default por usuário, sobrescrevível por request na geração;
  // teto em SPOT_MAX_RADIUS_KM.
  spotRadiusKm      Int       @default(10)

  /// Escolha explícita de idioma nas configurações. Null = seguir o aparelho.
  localePreference String?
  /// Última tag de idioma vista do aparelho (Accept-Language). Fallback para
  /// push/e-mail, que rodam em job sem request.
  deviceLocale     String  @default("pt-BR")
  /// IANA do aparelho. Usuário viaja; o evento não (Event.timezone é outro dado).
  timezone         String  @default("America/Sao_Paulo")

  // Preferências de produto, não consentimento: base legal é execução do
  // contrato / legítimo interesse, por isso nascem ligadas com opt-out no
  // PATCH /users/me. Moram aqui, e não em user_consents, para que ninguém
  // volte a tratá-las como declaração de vontade. A revogação do Art. 18
  // (DELETE /consent) também as desliga.
  socialFeed       Boolean @default(true)
  socialVisibility Boolean @default(true)
  analytics        Boolean @default(true)
  // Vincular o Spotify já expõe os top artistas no perfil (a tela de vínculo
  // avisa e leva ao toggle). Esconder tudo é aqui; esconder artista a artista
  // é o hiddenArtistIds do SpotifyLink.
  spotifyArtistsVisible Boolean @default(true)
  // Destacar o primeiro colocado acima da fileira. Só tem efeito quando a
  // fileira aparece — é escolha de layout, não uma segunda camada de privacidade.
  spotifyTopArtistVisible Boolean @default(true)
  // Seletor de período no perfil. Desligado, o visitante vê só a janela padrão.
  spotifyWindowVisible    Boolean @default(false)

  // Ciclo de vida da conta. accountStatus é a fonte da verdade do estado;
  // os timestamps abaixo são marcadores. deactivatedAt = momento em que a conta
  // saiu de ACTIVE (vale tanto para desativação quanto para exclusão agendada).
  // scheduledDeletionAt só existe em PENDING_DELETION. anonymizedAt em ANONYMIZED.
  accountStatus        AccountStatus       @default(ACTIVE)
  deactivatedAt        DateTime?
  scheduledDeletionAt  DateTime?
  anonymizedAt         DateTime?
  // Moderação: marcadores do estado SUSPENDED/BANNED. suspendedUntil null em
  // BANNED (permanente); preenchido em SUSPENDED (o reconciler expira quando
  // vence). suspensionReason guarda o motivo (audit + exibição no painel).
  suspendedAt          DateTime?
  suspendedUntil       DateTime?
  suspensionReason     String?
  events               Event[]
  attendances          EventAttendance[]
  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  commentReactions     CommentReaction[]
  eventInvitesSent     EventInvite[]       @relation("inviter")
  eventInvitesReceived EventInvite[]       @relation("invited")
  eventInviteLinks     EventInviteLink[]   @relation("inviteLinkCreator")
  socialAccounts       SocialAccount[]
  passwordResetCodes   PasswordResetCode[]
  refreshTokens        RefreshToken[]
  spotifyLink          SpotifyLink?
  spotifyTasteSnapshots SpotifyTasteSnapshot[]

  // Relacionamentos para o sistema de follow
  following Follow[] @relation("follower")
  followers Follow[] @relation("following")

  reports         Report[] @relation("reporterReports")
  reportsReceived Report[] @relation("targetUserReports")
  reviewedReports Report[] @relation("reportReviewer")

  featuredEventsCreated FeaturedEvent[] @relation("featuredEventCreator")
  subscriptions         Subscription[]
  eventSeries           EventSeries[]

  categoryPreferences    UserCategoryPreference[]
  subcategoryPreferences UserSubcategoryPreference[]

  // Chat
  conversationsCreated       Conversation[]            @relation("conversationsCreated")
  conversationParticipations ConversationParticipant[] @relation("conversationParticipations")
  messagesSent               Message[]                 @relation("messagesSent")
  blocksMade                 Block[]                   @relation("blocksMade")
  blocksReceived             Block[]                   @relation("blocksReceived")
  messageReactions           MessageReaction[]         @relation("messageReactions")

  // LGPD
  consent          UserConsent?
  consentLogs      ConsentAuditLog[]
  termsAcceptances TermsAcceptance[]

  // Ciclo de vida da conta (motivo de saída / churn)
  accountLifecycleLogs AccountLifecycleLog[]

  // Trilha de leitura de conteúdo privado pela moderação (quando é admin)
  moderationAccessLogs ModerationAccessLog[] @relation("moderationAccessLogs")

  // Notificações (push + in-app)
  deviceTokens  DeviceToken[]
  notifications Notification[]

  // Spots (rolês sugeridos, distintos de Event)
  spotsCreated        Spot[]                @relation("spotsCreated")
  spotGenerationUsage SpotGenerationUsage[]
  spotDiscoveryUsage  SpotDiscoveryUsage[]
  eventPromotionUsage EventPromotionUsage[]

  // Predicado do reconciler: PENDING_DELETION com scheduledDeletionAt vencido.
  @@index([accountStatus, scheduledDeletionAt])
  // Alvo do reconciler de expiração de suspensão (SUSPENDED + suspendedUntil <= now).
  @@index([accountStatus, suspendedUntil])
  @@map("users")
}

// Código OTP de recuperação de senha. Guardamos o HASH do código (nunca em
// claro): um vazamento do banco não revela o código enviado por e-mail.
// `attempts` limita o brute-force no espaço de 6 dígitos; `usedAt` garante uso
// único. Só um código ativo por usuário (os anteriores são apagados no request).
model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  // Busca o código vigente de um usuário (não usado e não expirado).
  @@index([userId, usedAt, expiresAt], map: "password_reset_codes_user_active_idx")
  @@map("password_reset_codes")
}

// Refresh token de sessão longa (rotativo, revogável). Guarda só o HASH do token
// bruto (SHA-256) — o valor em claro nunca toca o banco. `replacedByTokenId` liga
// a cadeia de rotação: ao renovar, o antigo é revogado e aponta para o novo.
// `rotatedAt` (setado atomicamente no claim da rotação) distingue revogação por
// ROTAÇÃO de revogação intencional (logout/reset/MFA): reapresentar um token
// rotacionado FORA da janela de carência dispara revogação de toda a família
// (reuso/comprometimento); dentro da janela é tratado como benigno (refresh
// concorrente ou retry de resposta perdida) e apenas reemite a sessão.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  rotatedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())

  // Lista/revoga as sessões de um usuário e separa as ainda válidas.
  @@index([userId, revokedAt, expiresAt], map: "refresh_tokens_user_active_idx")
  @@map("refresh_tokens")
}

enum EventCategory {
  MUSIC
  SPORTS
  TECH
  GASTRONOMY
  CAFE
  ART
  EDUCATION
  NIGHTLIFE
  BUSINESS
  HEALTH_WELLNESS
  OUTDOORS
  GAMING
  FILM_THEATER
  COMEDY
  FASHION
  MARKETS
  // RELIGION mantida como valor legado (dado existente) — NÃO selecionável:
  // removida das categorias disponíveis (SELECTABLE_CATEGORIES no app).
  RELIGION
  FAMILY
  PETS
  VOLUNTEERING
  PARTY
  OTHER
  BRECHO
  FESTIVAL
}

model UserCategoryPreference {
  id        String        @id @default(uuid())
  userId    String
  category  EventCategory
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("user_category_preferences")
}

// Preferência de SUBCATEGORIA (2º nível). `subcategory` é uma chave da taxonomia
// config (src/lib/subcategories.ts), validada no input — por isso String, não
// enum. Espelha UserCategoryPreference.
model UserSubcategoryPreference {
  id          String   @id @default(uuid())
  userId      String
  subcategory String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subcategory])
  @@index([userId])
  @@map("user_subcategory_preferences")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  title         String?
  createdById   String
  createdBy     User             @relation("conversationsCreated", fields: [createdById], references: [id])
  lastMessageAt DateTime?
  directKey     String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  spot         Spot?
  keys         ConversationKey[]

  @@index([lastMessageAt])
  @@index([createdById])
  @@map("conversations")
}

/// Chave de dados (DEK) da conversa, envelopada pela chave mestra (KEK).
/// Cifra o TEXTO das mensagens — a mídia usa DEK própria por anexo, porque o
/// material do anexo é entregue ao cliente e não pode abrir a conversa inteira.
///
/// Provisionada preguiçosamente na primeira escrita: conversas nascem em três
/// lugares (DM, grupo e spot), e criar a chave no envio cobre os três sem tocar
/// em nenhum.
model ConversationKey {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Versionada: a rotação cria a N+1 e aposenta a N, sem recifrar o histórico.
  version        Int
  wrappedDek     Bytes
  // Versão da KEK que envelopou — o unwrap usa ESTA, não a ativa, para as duas
  // conviverem durante a rotação.
  kekVersion     Int
  createdAt      DateTime     @default(now())
  retiredAt      DateTime?
  // Crypto-shredding: zerar a chave torna o ciphertext ruído permanente, sem
  // UPDATE em milhões de linhas.
  shreddedAt     DateTime?

  @@unique([conversationId, version])
  @@index([conversationId, retiredAt])
  // Só para o reconciler de rotação varrer `kekVersion < ativa` sem seq scan.
  @@index([kekVersion])
  @@map("conversation_keys")
}

model ConversationParticipant {
  id              String          @id @default(uuid())
  conversationId  String
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation("conversationParticipations", fields: [userId], references: [id], onDelete: Cascade)
  role            ParticipantRole @default(MEMBER)
  lastReadAt      DateTime?
  lastDeliveredAt DateTime?
  clearedAt       DateTime?
  joinedAt        DateTime        @default(now())
  leftAt          DateTime?
  createdAt       DateTime        @default(now())

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@index([conversationId, leftAt])
  @@map("conversation_participants")
}

enum MessageType {
  USER
  SYSTEM
}

model Message {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String
  sender            User         @relation("messagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  type              MessageType  @default(USER)
  // Plaintext LEGADO. Segue nullable durante a leitura dual (ciphertext quando
  // houver, este senão) e só é dropado depois do backfill — ver migration
  // drop_messages_content_plaintext.
  content           String?
  // Conteúdo cifrado: `1.<b64 iv>.<b64 tag>.<b64 ct>`. contentKeyVersion aponta
  // para a ConversationKey.version usada; a coluna nula é o que marca legado.
  contentCipher     String?
  contentKeyVersion Int?
  createdAt         DateTime     @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?

  // Resposta/citação a outra mensagem da mesma conversa.
  replyToId String?
  replyTo   Message?  @relation("messageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("messageReplies")

  // Idempotência de envio: chave gerada pelo cliente (header Idempotency-Key).
  // Retry com a mesma chave devolve a mensagem existente em vez de duplicar.
  // Null = sem idempotência (Postgres trata nulls como distintos no unique).
  idempotencyKey String?

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reports     Report[]

  @@unique([conversationId, senderId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("messageReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

enum AttachmentKind {
  IMAGE
  AUDIO
  VIDEO
}

model MessageAttachment {
  id           String         @id @default(uuid())
  messageId    String
  message      Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind         AttachmentKind @default(IMAGE)
  url          String
  key          String
  format       String
  size         Int
  durationMs   Int?
  waveform     Int[]
  width        Int?
  height       Int?
  thumbnailUrl String?
  thumbnailKey String?
  order        Int            @default(0)
  createdAt    DateTime       @default(now())

  // ── Cifra dos bytes da mídia ────────────────────────────────────────────────
  // DEK PRÓPRIA por anexo, envelopada pela KEK. NUNCA a DEK da conversa: este
  // material é entregue ao app para decifrar localmente, e um cliente
  // comprometido não pode ganhar o histórico de texto junto. dekWrapped nulo =
  // anexo legado (em claro no storage), servido como sempre foi.
  dekWrapped   Bytes?
  kekVersion   Int?
  // IV e tag em COLUNA, não no blob: assim o ciphertext tem exatamente o tamanho
  // do plaintext e a cota de storage (e o MAX_VIDEO_SIZE) seguem significando o
  // mesmo que antes — e o app não precisa fatiar o arquivo baixado.
  cipherIv     Bytes?
  cipherTag    Bytes?
  cipherAlg    String?
  plainSize    Int?
  // Só VIDEO: o app cifra em chunks para decifrar de forma incremental (50 MB
  // de uma vez é inviável em RN). Nesse modo a tag de cada chunk vai no blob,
  // então cipherTag fica nulo.
  chunkSize    Int?
  // O poster compartilha a DEK do anexo com IV PRÓPRIO — seguro em GCM enquanto
  // o IV não se repetir, e evita uma segunda chave para o mesmo anexo.
  thumbnailIv  Bytes?
  thumbnailTag Bytes?

  @@index([messageId, order])
  @@index([kekVersion])
  @@map("message_attachments")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum SocialProvider {
  GOOGLE
  FACEBOOK // legado: sem rota desde 2026-08, mantido pelas contas antigas
  APPLE
}

model SocialAccount {
  id             String         @id @default(uuid())
  userId         String
  provider       SocialProvider
  providerUserId String
  email          String?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

enum SpotifyLinkStatus {
  ACTIVE
  REVOKED // invalid_grant no refresh: revogado em spotify.com/account/apps
}

/// Conta do Spotify VINCULADA (nunca login — a identidade continua sendo a do
/// Clubber). Guarda só o material de longa duração: o access token é efêmero e
/// nunca é persistido.
model SpotifyLink {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Único: a mesma conta do Spotify não pode alimentar dois perfis Clubber.
  spotifyUserId String  @unique
  displayName   String?

  /// AES-256-GCM ("iv.tag.ct") com chave derivada do JWT_SECRET — ver
  /// src/lib/spotify/crypto.ts.
  refreshTokenEncrypted String
  /// Escopos concedidos no consentimento: é o gate de fases futuras
  /// (line-up, playlist) sem precisar pedir autorização de novo.
  scopes                String[]          @default([])
  status                SpotifyLinkStatus @default(ACTIVE)
  /// Artistas que o usuário tirou do próprio perfil. Mora no link (é escolha
  /// dele) e não no snapshot, que o sync substitui inteiro.
  hiddenArtistIds       String[]          @default([])

  lastSyncedAt  DateTime?
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Predicado do reconciler: ACTIVE com sync vencido (ou nunca sincronizado).
  @@index([status, lastSyncedAt])
  @@map("spotify_links")
}

/// Gosto musical derivado do Spotify. Dado DERIVADO, não histórico: o sync
/// substitui a linha inteira. Por contrato com o Spotify, nada aqui pode
/// alimentar publicidade, revenda ou treino de modelo — só personalização
/// dentro do app.
model SpotifyTasteSnapshot {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Janela do /me/top/artists ('short_term' | 'medium_term' | 'long_term').
  /// Uma linha por janela: "o que ouço agora" e "o que sempre ouvi" são
  /// perguntas diferentes, e a mesma chamada responde as duas.
  timeRange String
  /// [{ id, name, imageUrl, genres, rank }] — top artistas já ordenados.
  artists   Json

  /// Chaves GENRE_* da nossa taxonomia, ordenadas por afinidade (a ordem vira
  /// prioridade no ranking do feed, que só conta os primeiros interesses).
  genreKeys      String[] @default([])
  /// Gêneros crus do Spotify sem de-para: é a fila de curadoria do mapeamento.
  unmappedGenres String[] @default([])

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, timeRange])
  @@map("spotify_taste_snapshots")
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  id          String       @id @default(uuid())
  follower    User         @relation("follower", fields: [followerId], references: [id])
  followerId  String
  following   User         @relation("following", fields: [followingId], references: [id])
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, status, id])
  @@index([followerId, status, id])
  @@map("follows")
}

model Event {
  id            String          @id @default(uuid())
  title         String
  description   String?
  date          DateTime
  endDate       DateTime?
  /// IANA do LOCAL do evento, derivado de lat/lng. `date` continua sendo o
  /// instante UTC; a hora que o usuário marcou é hora de parede daqui.
  timezone      String
  latitude      Float
  longitude     Float
  address       String?
  placeId       String?
  venueName     String?
  categories    EventCategory[]
  // Subcategorias/gêneros (chaves de interesse config — src/lib/subcategories.ts).
  // text[] (não enum), validado no input. Casa com as preferências do usuário no
  // ranking do feed e nas notificações de proximidade (match de 2º nível).
  subcategories String[]        @default([])
  isPublic      Boolean         @default(true)
  isFeatured    Boolean         @default(false)
  maxCapacity   Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  canceledAt    DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Ocorrência de uma série recorrente (RF11.6). null = evento avulso. SetNull:
  // apagar a série não apaga as ocorrências já materializadas.
  seriesId String?
  series   EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  attendances      EventAttendance[]
  posts            Post[]
  comments         Comment[]
  reactions        Reaction[]
  invites          EventInvite[]
  inviteLinks      EventInviteLink[]
  reports          Report[]
  images           EventImage[]
  features         FeaturedEvent[]
  analyticsMetrics EventAnalyticsMetric[]

  // Único: uma ocorrência por (série, data). Torna a reposição idempotente e
  // segura contra reconcilers concorrentes. seriesId NULL é distinto no
  // Postgres, então eventos avulsos não são afetados.
  @@unique([seriesId, date])
  @@index([date])
  @@index([isPublic, date])
  @@index([isFeatured, date, id])
  @@index([categories], type: Gin)
  @@index([subcategories], type: Gin)
  // Join de visibilidade do autor (visibleAuthorWhere) na hidratação do mapa.
  @@index([authorId])
  @@map("events")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

// Série de eventos recorrentes (RF11.6, premium). A regra mora aqui; cada
// ocorrência é um Event materializado com seriesId apontando pra cá. O
// reconciler repõe ocorrências futuras até um horizonte rolante quando
// `until` é null. `count` (alternativa a `until`) limita o total de ocorrências.
// MONTHLY usa o mesmo dia do mês com clamp para o último dia em meses curtos;
// datas são UTC, então o horário local pode deslocar em mudanças de fuso/DST.
model EventSeries {
  id         String              @id @default(uuid())
  frequency  RecurrenceFrequency
  interval   Int                 @default(1)
  until      DateTime?
  count      Int?
  authorId   String
  author     User                @relation(fields: [authorId], references: [id])
  canceledAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // Template de conteúdo da série: o reconciler clona DESTES campos (não da
  // última ocorrência), então editar uma ocorrência individual não propaga
  // para as ocorrências geradas depois. Nullable: séries antigas não têm
  // template e o reconciler as pula. durationMs = endDate-date da 1ª ocorrência.
  title         String?
  description   String?
  /// Fuso do local da série: as ocorrências avançam nele, preservando a hora
  /// de parede através do DST (ver recurrence.ts).
  timezone      String?
  latitude      Float?
  longitude     Float?
  address       String?
  placeId       String?
  venueName     String?
  categories    EventCategory[]
  // Template de subcategorias: o reconciler clona daqui para cada ocorrência.
  subcategories String[]        @default([])
  maxCapacity   Int?
  isPublic      Boolean         @default(true)
  durationMs    Int?

  events Event[]

  // Predicado do reconciler: séries vivas que ainda podem crescer.
  @@index([canceledAt, until])
  @@map("event_series")
}

enum EventAnalyticsMetricType {
